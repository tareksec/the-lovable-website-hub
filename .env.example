# ---------------------------------------------------------------
# FRONTEND environment variables (safe to expose in the browser)
# Vercel: add these under Project Settings > Environment Variables
# ---------------------------------------------------------------

# Backend / API base URL. Leave empty to use same-origin requests.
# Example for a Railway backend: https://bec-api.up.railway.app
VITE_API_BASE_URL=

# Public database / auth config (publishable keys only — never secrets)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Public site URL (used for canonical/OG links)
VITE_SITE_URL=https://bec.example.com
