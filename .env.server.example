# ---------------------------------------------------------------
# BACKEND / SERVER environment variables (NEVER exposed to browser)
# Railway: add these under Service > Variables
# ---------------------------------------------------------------

# Server runtime
NODE_ENV=production
PORT=3000

# Database / auth (server-side)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxx
SUPABASE_PROJECT_ID=your-project-ref

# Direct Postgres connection (only if the backend talks to Postgres directly)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# CORS: comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://bec.example.com,https://bec.vercel.app

# Secret used to verify inbound webhooks
WEBHOOK_SECRET=change-me
